{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2.0.0/crates/tauri-utils/schema.json",
  "productName": "IEM Mixer",
  "version": "1.24.0",
  "identifier": "com.reaperiem.mixer",
  "build": {
    "frontendDist": "../iem-ui/dist",
    "devUrl": "http://localhost:80"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "IEM Mixer",
        "url": "http://localhost:80",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 400
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "IEM Mixer"
      }
    },
    "createUpdaterArtifacts": false
  }
}
