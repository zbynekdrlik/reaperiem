#!/bin/bash
# =============================================================================
# PRE-COMMIT HOOK FOR IEM.LAN (REAPER MACHINE)
# =============================================================================
# REJECTS commits that touch CODE files
# Code should only be modified on dev machine
# =============================================================================

# Get list of staged files
STAGED=$(git diff --cached --name-only)

# Forbidden patterns for iem.lan - CODE files
FORBIDDEN_PATTERNS=(
    "^mcp/.*"
    "^scripts/.*"
    "^web/.*"
    "^config/.*\.yaml$"
    ".*\.py$"
    ".*\.lua$"
    ".*\.sh$"
    ".*\.html$"
    ".*\.js$"
    ".*\.md$"
    "^\.claude/.*"
    "^\.gitignore$"
)

# Allowed patterns (override forbidden)
ALLOWED_PATTERNS=(
    "^projects/.*"
    ".*\.RPP$"
    ".*\.RPP-bak$"
    "^data/.*"
)

is_allowed() {
    local file=$1
    for pattern in "${ALLOWED_PATTERNS[@]}"; do
        if [[ $file =~ $pattern ]]; then
            return 0
        fi
    done
    return 1
}

is_forbidden() {
    local file=$1
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ $file =~ $pattern ]]; then
            return 0
        fi
    done
    return 1
}

BLOCKED=""
for file in $STAGED; do
    if is_allowed "$file"; then
        continue
    fi
    if is_forbidden "$file"; then
        BLOCKED="$BLOCKED\n  - $file"
    fi
done

if [[ -n "$BLOCKED" ]]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║  ❌ COMMIT BLOCKED - WRONG MACHINE FOR THESE FILES            ║"
    echo "╠═══════════════════════════════════════════════════════════════╣"
    echo "║  CODE files should only be committed on the dev machine,      ║"
    echo "║  not on iem.lan (REAPER machine).                             ║"
    echo "║                                                               ║"
    echo "║  This machine should ONLY commit:                             ║"
    echo "║    - projects/*.RPP (REAPER project files)                    ║"
    echo "║                                                               ║"
    echo "║  Blocked files:                                               ║"
    echo -e "$BLOCKED"
    echo "║                                                               ║"
    echo "║  To unstage: git reset HEAD <file>                            ║"
    echo "║  To get latest code: git pull origin main                     ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

exit 0
