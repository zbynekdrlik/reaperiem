#!/bin/bash
# =============================================================================
# PRE-COMMIT HOOK FOR DEV MACHINE
# =============================================================================
# REJECTS commits that touch REAPER project files
# These should only be modified on iem.lan
# =============================================================================

# Get list of staged files
STAGED=$(git diff --cached --name-only)

# Forbidden patterns for dev machine
FORBIDDEN_PATTERNS=(
    "projects/.*\.RPP$"
    "projects/.*\.RPP-bak$"
    "projects/.*\.RPP-UNDO$"
)

BLOCKED=""
for file in $STAGED; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ $file =~ $pattern ]]; then
            BLOCKED="$BLOCKED\n  - $file"
        fi
    done
done

if [[ -n "$BLOCKED" ]]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║  ❌ COMMIT BLOCKED - WRONG MACHINE FOR THESE FILES            ║"
    echo "╠═══════════════════════════════════════════════════════════════╣"
    echo "║  REAPER project files (.RPP) should only be committed on      ║"
    echo "║  iem.lan, not on the dev machine.                             ║"
    echo "║                                                               ║"
    echo "║  Blocked files:                                               ║"
    echo -e "$BLOCKED"
    echo "║                                                               ║"
    echo "║  To unstage: git reset HEAD <file>                            ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

exit 0
